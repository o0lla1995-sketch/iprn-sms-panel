# ── Core ───────────────────────────────────────────────────────
DATABASE_URL=file:/app/db/custom.db
SESSION_SECRET=change-me-long-random-string
PORT=3000

# ── Bootstrap admin (created on first boot) ────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=choose-a-strong-password
SEED_DEMO=false

# ── SMPP gateway (supplier connector) ─────────────────────────
ENABLE_SMPP=true
SMPP_PORT=2775
UPSTREAM_SMPP_SYSTEM_ID=choose-a-system-id
UPSTREAM_SMPP_PASSWORD=choose-a-connector-password

# ── Upstream wholesale platform ────────────────────────────────
UPSTREAM_BASE_URL=https://sms.carefulsupport.com
UPSTREAM_API_KEY=
PUBLIC_URL=https://panel.yourdomain.com
MO_WEBHOOK_SECRET=generate-a-random-secret
